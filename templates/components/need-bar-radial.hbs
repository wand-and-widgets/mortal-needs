<div class="mn-need-bar mn-need-bar--radial {{#if hasCustomColor}}mn-need-bar--custom-color{{/if}}" data-need-id="{{id}}" data-entity-id="{{entityId}}" data-severity="{{severity}}" data-tooltip="{{localizedLabel}}: {{percentageLabel}}" {{#if color}}style="--mn-need-color: {{color}};"{{/if}}>
  <div class="mn-need-bar__ring-wrap">
    <svg class="mn-need-bar__ring" viewBox="0 0 44 44" aria-hidden="true">
      <circle class="mn-need-bar__ring-track" cx="22" cy="22" r="18" />
      <circle class="mn-need-bar__ring-fill"
              data-severity="{{severity}}"
              cx="22" cy="22" r="18"
              stroke-dasharray="{{circumference}}"
              stroke-dashoffset="{{dashOffset}}" />
    </svg>
    <span class="mn-need-bar__radial-icon" data-severity="{{severity}}">
      {{mnIcon this}}
    </span>
  </div>

  <span class="mn-need-bar__value" data-severity="{{severity}}">{{percentageLabel}}</span>

  <div class="mn-need-bar__controls">
    <button type="button"
            class="mn-need-bar__btn mn-need-bar__btn--relieve"
            data-action="relieve"
            data-entity-id="{{entityId}}"
            data-need-id="{{id}}"
            data-tooltip="{{localize 'MORTAL_NEEDS.Actions.Relieve'}}" aria-label="{{localize 'MORTAL_NEEDS.Actions.Relieve'}}">
      <i class="mn-icon fa-minus" aria-hidden="true"></i>
    </button>
    <button type="button"
            class="mn-need-bar__btn mn-need-bar__btn--stress"
            data-action="stress"
            data-entity-id="{{entityId}}"
            data-need-id="{{id}}"
            data-tooltip="{{localize 'MORTAL_NEEDS.Actions.Stress'}}" aria-label="{{localize 'MORTAL_NEEDS.Actions.Stress'}}">
      <i class="mn-icon fa-plus" aria-hidden="true"></i>
    </button>
  </div>
</div>
